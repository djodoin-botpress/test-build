  "scripts": {
    "dev": "next dev",
    "build-legacy": "LEGACY_BUILD=true HARDCODE_CONFIG_WITH_PLACEHOLDER=true next build",
    "build": "HARDCODE_CONFIG_WITH_PLACEHOLDER=true next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && cp start.sh .next/standalone/ && yarn generate-inject-env-bash && yarn patch-server-js",
    "generate-inject-env-bash": "node utils/generateInjectEnvBash.js && chmod +x update-env.sh",
    "patch-server-js": "node utils/patch-server-js.js",
    "run:dev": "chmod +x ./switch-env.sh && ./switch-env.sh dev && next dev",
    "run:prod": "chmod +x ./switch-env.sh && ./switch-env.sh prod && next dev",
    "run:qa": "chmod +x ./switch-env.sh && ./switch-env.sh qa && next dev",
    "start": "next start",
    "lint:next": "next lint",
    "tsc": "tsc",
    "lint": "eslint \"./src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix --quiet \"./src/**/*.{js,jsx,ts,tsx}\"",
    "lint:style": "stylelint --fix \"src/**/*.{css,scss}\"",
    "test": "jest --coverage",
    "test:coverage": "jest --coverage -u",
    "prepare": "husky install",
    "analyze": "ANALYZE=true next build",
    "lint:check": "yarn lint && yarn tsc",
    "cleanup": "rm -rf node_modules && yarn",
    "find-unused-exports": "ts-prune",
    "find-dead-code": "ts-prune | (! grep -v 'used in module')"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
